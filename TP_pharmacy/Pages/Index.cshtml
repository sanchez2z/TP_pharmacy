@page
@model TP_pharmacy.Pages.IndexModel
@{
    ViewData["Title"] = "Главная";
}

<div class="text-center">
    <h1 class="display-4">Добро пожаловать в систему Аптека</h1>
    <p class="lead">Удобная онлайн-платформа для покупки лекарств и товаров для здоровья</p>

    <div class="row mt-5">
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Каталог товаров</h5>
                    <p class="card-text">Широкий ассортимент лекарств и товаров для здоровья</p>
                    <a asp-page="/Catalog/Index" class="btn btn-primary">Перейти в каталог</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Онлайн-заказы</h5>
                    <p class="card-text">Оформляйте заказы онлайн и забирайте в удобной аптеке</p>
                    <a asp-page="/Orders/Index" class="btn btn-primary">Мои заказы</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Бонусная программа</h5>
                    <p class="card-text">Копите бонусы и получайте скидки на покупки</p>
                    <a asp-page="/Account/Register" class="btn btn-primary">Зарегистрироваться</a>
                </div>
            </div>
        </div>
    </div>
</div>
