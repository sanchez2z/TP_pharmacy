@page
@model TP_pharmacy.Pages.Cart.CartIndexModel
@{ ViewData["Title"] = "Корзина"; }
<h1>Корзина</h1><div asp-validation-summary="All" class="text-danger"></div>
@if (Model.Cart == null || Model.Cart.CartItems.Count == 0)
{
    <p>Корзина пуста.</p><a asp-page="/Catalog/Index">В каталог</a>
}
else
{
    <table class="table"><thead><tr><th>Товар</th><th>Цена</th><th>Количество</th><th></th></tr></thead><tbody>
    @foreach (var item in Model.Cart.CartItems)
    {
        <tr><td>@item.Product.Name</td><td>@item.Product.Price.ToString("N2") ₽</td><td>
            <form method="post" asp-page-handler="UpdateQuantity"><input name="cartItemId" value="@item.Id" type="hidden" />
                <input name="quantity" type="number" value="@item.Quantity" min="1" /><button class="btn btn-sm btn-secondary">Изменить</button>
            </form></td><td>
            <form method="post" asp-page-handler="Remove"><input name="cartItemId" value="@item.Id" type="hidden" /><button class="btn btn-sm btn-danger">Удалить</button></form>
        </td></tr>
    }
    </tbody></table>
    <p>Итого: @Model.TotalCost.ToString("N2") ₽</p><a asp-page="/Orders/Create" class="btn btn-success">Оформить заказ</a>
}
