@page
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Manager")]
@model TP_pharmacy.Pages.Manager.ManagerDashboardModel
@{
    ViewData["Title"] = "Панель менеджера";
}

<h1>Панель менеджера</h1>

<div class="row">
    <div class="col-md-4">
        <div class="card text-center">
            <div class="card-body">
                <h5 class="card-title">Товары</h5>
                <p class="display-4">@Model.ProductsCount</p>
                <a asp-page="./Products" class="btn btn-primary">Управление</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center">
            <div class="card-body">
                <h5 class="card-title">Остатки</h5>
                <p class="display-4">@Model.StocksCount</p>
                <a asp-page="./Stock" class="btn btn-primary">Управление</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center">
            <div class="card-body">
                <h5 class="card-title">Сотрудники</h5>
                <p class="display-4">@Model.EmployeesCount</p>
                <a asp-page="./Employees" class="btn btn-primary">Управление</a>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-12">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Отчётность</h5>
                <div class="row g-3">
                    <div class="col-md-3">
                        <strong>Выручка</strong>
                        <div class="fs-4">@Model.Revenue.ToString("N2") ₽</div>
                    </div>
                    <div class="col-md-3">
                        <strong>Продано единиц</strong>
                        <div class="fs-4">@Model.SoldItems</div>
                    </div>
                    <div class="col-md-3">
                        <strong>Средний чек</strong>
                        <div class="fs-4">@Model.AverageCheck.ToString("N2") ₽</div>
                    </div>
                    <div class="col-md-3">
                        <strong>Товаров с малым остатком</strong>
                        <div class="fs-4">@Model.LowStockProductsCount</div>
                    </div>
                </div>

                <hr />

                <p class="mb-0">
                    <strong>Самый продаваемый товар:</strong>
                    @if (Model.BestSellingProduct is null)
                    {
                        <span>данных о продажах пока нет</span>
                    }
                    else
                    {
                        <span>
                            @Model.BestSellingProduct.ProductName
                            (@Model.BestSellingProduct.Quantity шт.)
                        </span>
                    }
                </p>
            </div>
        </div>
    </div>
</div>
