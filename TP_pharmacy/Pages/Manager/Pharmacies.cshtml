@page
@model TP_pharmacy.Pages.Manager.PharmaciesModel
@{ ViewData["Title"] = "Аптеки"; }
<h1>Аптеки</h1>
<div asp-validation-summary="All" class="text-danger"></div>
<form method="post" asp-page-handler="Save" class="card card-body mb-3">
    <input asp-for="Input.Id" type="hidden" />
    <label>Адрес <input asp-for="Input.Address" class="form-control" /></label>
    <label>Телефон <input asp-for="Input.PhoneNumber" class="form-control" /></label>
    <button class="btn btn-success mt-2">Сохранить</button><a asp-page="./Pharmacies">Новая аптека</a>
</form>
<table class="table"><thead><tr><th>Адрес</th><th>Телефон</th><th></th></tr></thead><tbody>
@foreach (var p in Model.Pharmacies)
{
    <tr><td>@p.Address</td><td>@p.PhoneNumber</td><td><a asp-route-id="@p.Id">Изменить</a>
        <form method="post" asp-page-handler="Delete" class="d-inline"><input name="id" type="hidden" value="@p.Id" /><button class="btn btn-sm btn-danger">Удалить</button></form>
    </td></tr>
}
</tbody></table>
