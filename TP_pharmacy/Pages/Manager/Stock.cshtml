@page
@model TP_pharmacy.Pages.Manager.StockModel
@{ ViewData["Title"] = "Остатки"; }
<h1>Партии товаров</h1>
<div asp-validation-summary="All" class="text-danger"></div>
<form method="post" asp-page-handler="Save" class="card card-body mb-3">
    <input asp-for="Input.Id" type="hidden" />
    <label>Аптека <select asp-for="Input.PharmacyId" class="form-select"><option value="">Выберите аптеку</option>
        @foreach (var p in Model.Pharmacies) { <option value="@p.Id">@p.Address</option> }
    </select></label>
    <label>Товар <select asp-for="Input.ProductId" class="form-select"><option value="">Выберите товар</option>
        @foreach (var p in Model.Products) { <option value="@p.Id">@p.Name</option> }
    </select></label>
    <label>Количество <input asp-for="Input.Quantity" class="form-control" /></label>
    <label>Годен до <input asp-for="Input.ExpiryDate" type="date" class="form-control" /></label>
    <button class="btn btn-success mt-2">Сохранить партию</button><a asp-page="./Stock">Новая партия</a>
</form>
<table class="table"><thead><tr><th>Аптека</th><th>Товар</th><th>Остаток</th><th>Годен до</th><th></th></tr></thead><tbody>
@foreach (var s in Model.Stocks)
{
    <tr class="@(s.ExpiryDate.Date < DateTime.UtcNow.Date ? "table-danger" : "")"><td>@s.Pharmacy.Address</td><td>@s.Product.Name</td><td>@s.Quantity</td><td>@s.ExpiryDate.ToString("dd.MM.yyyy")</td><td>
        <a asp-route-id="@s.Id">Изменить</a>
        <form method="post" asp-page-handler="Delete" class="d-inline"><input name="id" type="hidden" value="@s.Id" /><button class="btn btn-sm btn-danger">Удалить</button></form>
    </td></tr>
}
</tbody></table>
