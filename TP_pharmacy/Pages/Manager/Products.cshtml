@page
@model TP_pharmacy.Pages.Manager.ProductsModel
@{ ViewData["Title"] = "Товары"; }
<h1>Управление товарами</h1>
<div asp-validation-summary="All" class="text-danger"></div>
<form method="post" asp-page-handler="Save" class="card card-body mb-3">
    <input type="hidden" asp-for="Input.Id" />
    <label>Название <input asp-for="Input.Name" class="form-control" /></label>
    <label>Цена <input asp-for="Input.Price" type="number" step="0.01" min="0.01" class="form-control" /></label>
    <label>Категория <input asp-for="Input.Category" class="form-control" /></label>
    <label>Описание <textarea asp-for="Input.Description" class="form-control"></textarea></label>
    <label><input asp-for="Input.RequiresPrescription" /> Отпускается по рецепту</label>
    <button class="btn btn-success mt-2">Сохранить</button>
    <a asp-page="./Products">Новый товар / отмена редактирования</a>
</form>
<table class="table"><thead><tr><th>Товар</th><th>Категория</th><th>Цена</th><th>Действия</th></tr></thead><tbody>
@foreach (var product in Model.Products)
{
    <tr><td>@product.Name</td><td>@product.Category</td><td>@product.Price.ToString("N2") ₽</td><td>
        <a asp-route-id="@product.Id">Изменить</a>
        <form method="post" asp-page-handler="Delete" class="d-inline"><input type="hidden" name="id" value="@product.Id" /><button class="btn btn-sm btn-danger">Удалить</button></form>
    </td></tr>
}
</tbody></table>
