@page "{id:int}"
@model TP_pharmacy.Pages.Catalog.DetailsModel
@{ ViewData["Title"] = Model.Product.Name; }
<h1>@Model.Product.Name</h1>
<p>@Model.Product.Category</p><p>@Model.Product.Description</p><h2>@Model.Product.Price.ToString("N2") ₽</h2>
<div asp-validation-summary="All" class="text-danger"></div>
@if (Model.Product.RequiresPrescription)
{
    <p class="alert alert-warning">Отпускается только в аптеке по действительному рецепту.</p>
}
else
{
    @if (User.Identity?.IsAuthenticated != true || User.IsInRole("Customer"))
    {
        <form method="post" data-cart-form data-guest="@(User.Identity?.IsAuthenticated != true ? "true" : "false")">
            <label asp-for="Quantity">Количество</label>
            <div class="input-group mb-2" data-quantity-control>
                <button type="button" class="btn btn-outline-secondary" data-quantity-step="-1" aria-label="Уменьшить количество">−</button>
                <input asp-for="Quantity" min="1" max="10000" class="form-control" />
                <button type="button" class="btn btn-outline-secondary" data-quantity-step="1" aria-label="Увеличить количество">+</button>
            </div>
            <button class="btn btn-success">В корзину</button>
        </form>
    }
    else { <p>Покупки доступны в учётной записи покупателя.</p> }
}
<h2 class="h4 mt-3">Наличие в аптеках</h2>
@if (Model.Stocks.Count == 0) { <p>Нет в наличии.</p> }
@foreach (var group in Model.Stocks.GroupBy(s => s.Pharmacy.Address))
{
    <p>@group.Key — @group.Sum(s => s.Quantity) шт.</p>
}
